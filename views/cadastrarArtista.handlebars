<h2><span uk-icon="icon: plus-circle; ratio: 1.5"></span> Cadastrar Artista</h2>

<form action="/artistas" method="POST" class="uk-form-stacked uk-width-1-2@m">

  <div class="uk-margin">
    <label class="uk-form-label">Nome do Artista:</label>
    <div class="uk-form-controls">
      <input class="uk-input" type="text" name="nome">
    </div>
  </div>
  <div class="uk-margin">
    <label class="uk-form-label">Ano de Nascimento:</label>
    <div class="uk-form-controls">
      <input class="uk-input" type="number" name="anoNascimento">
    </div>
  </div>
  <div class="uk-margin">
    <label class="uk-form-label">Nome artístico:</label>
    <div class="uk-form-controls">
      <input class="uk-input" type="text" name="nomeArtistico">
    </div>
  </div>
  <div class="uk-margin">
    <label><input class="uk-checkbox" type="checkbox" name="emAtividade"> Em atividade?</label>
  </div>
  <div class="uk-margin">
    <label class="uk-form-label">Foto (URL):</label>
    <div class="uk-form-controls">
      <input class="uk-input" type="text" name="foto">
    </div>
  </div>
  <div class="uk-margin">
    <label class="uk-form-label">Filmes:</label>
    <div class="uk-form-controls">
      <select class="uk-select" name="filmes" multiple>
        {{#each filmes}}
          <option value="{{this.id}}">{{this.nome}}</option>
        {{/each}}
      </select>
    </div>
  </div>

  <input type="submit" class="uk-button uk-button-primary" value="Cadastrar">
  <a href="/artistas" class="uk-margin-left">Cancelar</a>

</form>
