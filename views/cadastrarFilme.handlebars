<h2><span uk-icon="icon: plus-circle; ratio: 1.5"></span> Cadastrar Filme</h2>

<form action="/filmes" method="POST" class="uk-form-stacked uk-width-1-2@m">

  <div class="uk-margin">
    <label class="uk-form-label">Nome do Filme:</label>
    <div class="uk-form-controls">
      <input class="uk-input" type="text" name="nome">
    </div>
  </div>
  <div class="uk-margin">
    <label class="uk-form-label">Ano:</label>
    <div class="uk-form-controls">
      <input class="uk-input" type="number" name="ano">
    </div>
  </div>
  <div class="uk-margin">
    <label class="uk-form-label">Diretor:</label>
    <div class="uk-form-controls">
      <select class="uk-select" name="diretorId">
        {{#each diretores}}
          <option value="{{this.id}}">{{this.nome}}</option>
        {{/each}}
      </select>
    </div>
  </div>
  <div class="uk-margin">
    <label class="uk-form-label">Artistas:</label>
    <div class="uk-form-controls">
      <select class="uk-select" name="artistas" multiple>
        {{#each artistas}}
          <option value="{{this.id}}">{{this.nome}}</option>
        {{/each}}
      </select>
    </div>
  </div>

  <input type="submit" class="uk-button uk-button-primary" value="Cadastrar">
  <a href="/filmes" class="uk-margin-left">Cancelar</a>

</form>
