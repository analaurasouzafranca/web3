<h2><span uk-icon="icon: video-camera; ratio: 1.5"></span> Lista de Filmes</h2>

<p>
  <a href="/filmes/cadastrar" class="uk-link-heading">
    <span uk-icon="plus-circle"></span> Cadastrar Filme
  </a>
</p>

<!-- LISTA -->
<ul class="uk-list uk-list-divider uk-card uk-card-default uk-card-body"
    uk-scrollspy="cls: uk-animation-fade; target: > li; delay: 100">

  {{#each filmes}}
    <li class="uk-flex uk-flex-between uk-flex-middle">
      <a href="/filmes/{{this.id}}">{{this.nome}} - {{this.ano}}</a>
      <span>
        <a href="/filmes/{{this.id}}/editar" class="uk-icon-link uk-margin-small-right" uk-icon="pencil"></a>
        <form action="/filmes/{{this.id}}?_method=DELETE" method="POST" style="display: inline;">
          <button type="submit" class="uk-icon-link" uk-icon="trash"
                style="border:0; background:none; padding:0; cursor:pointer;"></button>
        </form>
      </span>
    </li>
  {{else}}
    <li>Nada cadastrado ainda.</li>
  {{/each}}

</ul>
