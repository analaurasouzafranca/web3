<div class="uk-background-cover uk-background-secondary uk-light uk-padding-large uk-margin-large-bottom"
     style="background-image: url('https://encrypted-tbn0.gstatic.com/images?q=tbn:ANd9GcQGrzLBVCjf-_FlGWS9WPIrQyk3XPaIhC1NpkrTOdRLYg&s=10');">
  <h1 class="uk-heading-medium"style="color: #000000;">{{titulo}}</h1>
  <p style="color: #000000;">Bem-vindo ao sistema de filmes.</p>
</div>

<div class="uk-child-width-1-4@m uk-child-width-1-2@s uk-grid-match" uk-grid
     uk-scrollspy="cls: uk-animation-slide-bottom-small; target: > div; delay: 150">
  <div>
    <a class="uk-card uk-card-default uk-card-body uk-card-hover uk-link-reset uk-text-center" href="/filmes">
      <span uk-icon="icon: video-camera; ratio: 3"></span>
      <h3 class="uk-card-title">Filmes</h3>
    </a>
  </div>
  <div>
    <a class="uk-card uk-card-default uk-card-body uk-card-hover uk-link-reset uk-text-center" href="/artistas">
      <span uk-icon="icon: users; ratio: 3"></span>
      <h3 class="uk-card-title">Artistas</h3>
    </a>
  </div>
  <div>
    <a class="uk-card uk-card-default uk-card-body uk-card-hover uk-link-reset uk-text-center" href="/diretores">
      <span uk-icon="icon: camera; ratio: 3"></span>
      <h3 class="uk-card-title">Diretores</h3>
    </a>
  </div>
  <div>
    <a class="uk-card uk-card-default uk-card-body uk-card-hover uk-link-reset uk-text-center" href="/fichas">
      <span uk-icon="icon: file-text; ratio: 3"></span>
      <h3 class="uk-card-title">Fichas Técnicas</h3>
    </a>
  </div>
</div>
