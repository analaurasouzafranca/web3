<h2><span uk-icon="icon: plus-circle; ratio: 1.5"></span> Cadastrar Diretor</h2>

<form action="/diretores" method="POST" class="uk-form-stacked uk-width-1-2@m">

  <div class="uk-margin">
    <label class="uk-form-label">Nome do Diretor:</label>
    <div class="uk-form-controls">
      <input class="uk-input" type="text" name="nome">
    </div>
  </div>
  <div class="uk-margin">
    <label class="uk-form-label">Ano de Nascimento:</label>
    <div class="uk-form-controls">
      <input class="uk-input" type="number" name="anoNascimento">
    </div>
  </div>
  <div class="uk-margin">
    <label class="uk-form-label">Nacionalidade:</label>
    <div class="uk-form-controls">
      <input class="uk-input" type="text" name="nacionalidade">
    </div>
  </div>

  <input type="submit" class="uk-button uk-button-primary" value="Cadastrar">
  <a href="/diretores" class="uk-margin-left">Cancelar</a>

</form>
